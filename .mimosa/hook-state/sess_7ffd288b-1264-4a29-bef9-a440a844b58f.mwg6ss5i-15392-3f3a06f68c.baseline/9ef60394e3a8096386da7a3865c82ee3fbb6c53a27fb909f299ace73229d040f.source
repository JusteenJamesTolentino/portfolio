import {
  BriefcaseBusiness,
  Contact,
  FolderGit2,
  Gauge,
  Globe2,
  Settings,
  Terminal,
  User,
  Wrench,
} from 'lucide-react';

export const OS_APPS = [
  { id: 'about', title: 'About Me', icon: User, color: 'text-cyan-300', bg: 'bg-cyan-400/15', size: { width: 720, height: 520 } },
  { id: 'projects', title: 'Projects', icon: FolderGit2, color: 'text-purple-300', bg: 'bg-purple-400/15', size: { width: 820, height: 560 } },
  { id: 'skills', title: 'Skills', icon: Gauge, color: 'text-emerald-300', bg: 'bg-emerald-400/15', size: { width: 680, height: 500 } },
  { id: 'services', title: 'Services', icon: BriefcaseBusiness, color: 'text-blue-300', bg: 'bg-blue-400/15', size: { width: 760, height: 520 } },
  { id: 'tools', title: 'Tools', icon: Wrench, color: 'text-amber-300', bg: 'bg-amber-400/15', size: { width: 760, height: 520 } },
  { id: 'browser', title: 'Browser', icon: Globe2, color: 'text-sky-300', bg: 'bg-sky-400/15', size: { width: 920, height: 620 } },
  { id: 'contact', title: 'Contact', icon: Contact, color: 'text-pink-300', bg: 'bg-pink-400/15', size: { width: 700, height: 560 } },
  { id: 'terminal', title: 'Terminal', icon: Terminal, color: 'text-lime-300', bg: 'bg-lime-400/15', size: { width: 680, height: 440 } },
  { id: 'settings', title: 'Settings', icon: Settings, color: 'text-slate-200', bg: 'bg-slate-400/15', size: { width: 620, height: 480 } },
];

export function getOsApp(id) {
  return OS_APPS.find(app => app.id === id);
}
